        )
    }
}


def run(command):
    subprocess.run(command, check=True)


def font(size):
    candidates = [
        "/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf",
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"
    ]
    for name in candidates:
        if Path(name).exists():
            try:
                return ImageFont.truetype(name, size)
            except OSError:
                pass
    return ImageFont.load_default()


def prepare_scene(source, destination, caption, title=None):
    image = Image.open(source).convert("RGB")
    image = ImageOps.fit(image, (WIDTH, HEIGHT))
    image = image.convert("RGBA")

    overlay = Image.new("RGBA", image.size, (0, 0, 0, 0))
    draw = ImageDraw.Draw(overlay)

    # Dark panel behind text
    draw.rectangle(
        (0, 1450, WIDTH, HEIGHT),
        fill=(0, 0, 0, 175)
    )

    if title:
        title_font = font(66)
        draw.multiline_text(
            (55, 120),
            title,
            font=title_font,
            fill=(255, 255, 255, 255),
            spacing=14,
            stroke_width=2,
            stroke_fill=(0, 0, 0, 255)
        )

    draw.multiline_text(
        (55, 1530),
        caption,
        font=font(52),
        fill=(255, 255, 255, 255),
        spacing=18,
        stroke_width=2,
        stroke_fill=(0, 0, 0, 255)
    )

    Image.alpha_composite(image, overlay).convert("RGB").save(
        destination, quality=94
    )


async def make_voice(text, voice, destination):
    communicate = edge_tts.Communicate(text, voice)
    await communicate.save(str(destination))


def main():
    WORK.mkdir(exist_ok=True)
    OUT.mkdir(exist_ok=True)

    missing = [
        str(ASSETS / f"scene{i:02d}.jpg")
        for i in range(1, SCENES + 1)
        if not (ASSETS / f"scene{i:02d}.jpg").exists()
    ]
    if missing:
        raise FileNotFoundError(
            "Upload these six scene images first:\n" +
            "\n".join(missing)
        )

    for lang, data in DATA.items():
        print(f"Creating {lang.upper()} version")

        frames = []
        for i, caption in enumerate(data["captions"], start=1):
            frame = WORK / f"{lang}_{i:02d}.jpg"
            prepare_scene(
                ASSETS / f"scene{i:02d}.jpg",
                frame,
                caption,
                data["title"] if i == 1 else None
            )
            frames.append(frame)

        clips = []
        for i, frame in enumerate(frames, start=1):
            clip = WORK / f"{lang}_clip_{i:02d}.mp4"
            run([
                "ffmpeg", "-y", "-loglevel", "error",
                "-loop", "1", "-framerate", str(FPS),
                "-i", str(frame),
                "-vf",
                f"scale=1166:2073,"
                f"crop=1080:1920,"
                f"zoompan=z='min(zoom+0.00035,1.06)':"
                f"x='iw/2-(iw/zoom/2)':"
                f"y='ih/2-(ih/zoom/2)':"
                f"d={SCENE_SECONDS * FPS}:s=1080x1920:fps={FPS},"
                f"format=yuv420p",
                "-t", str(SCENE_SECONDS),
                "-an", "-c:v", "libx264", "-preset", "ultrafast",
                str(clip)
            ])
            clips.append(clip)

        concat_file = WORK / f"{lang}_concat.txt"
        concat_file.write_text(
            "".join(f"file '{p.resolve()}'\n" for p in clips),
            encoding="utf-8"
        )

        silent_video = WORK / f"{lang}_silent.mp4"
        run([
            "ffmpeg", "-y", "-loglevel", "error",
            "-f", "concat", "-safe", "0",
            "-i", str(concat_file),
            "-c", "copy", str(silent_video)
        ])

        voice_file = WORK / f"{lang}_voice.mp3"
        asyncio.run(make_voice(
            data["narration"], data["voice"], voice_file
        ))

        final = OUT / f"crownless_{lang}.mp4"
        run([
            "ffmpeg", "-y", "-loglevel", "error",
            "-i", str(silent_video),
            "-i", str(voice_file),
            "-vf", "scale=1080:1920,setsar=1",
            "-af", "apad",
            "-t", str(TOTAL_SECONDS),
            "-c:v", "libx264", "-preset", "ultrafast",
            "-pix_fmt", "yuv420p",
            "-c:a", "aac", "-b:a", "128k",
            "-shortest", str(final)
        ])

        print(f"Finished: {final}")

    print("Both language versions are ready.")


if __name__ == "__main__":
    main()
