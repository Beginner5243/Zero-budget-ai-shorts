
import asyncio
import subprocess
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont, ImageOps
import edge_tts

ROOT = Path(__file__).parent
ASSETS = ROOT / "assets"
WORK = ROOT / "work"
OUT = ROOT / "output"

WIDTH, HEIGHT = 1080, 1920
FPS = 24
SCENE_SECONDS = 7
SCENES = 6
TOTAL_SECONDS = SCENE_SECONDS * SCENES

DATA = {
    "en": {
        "voice": "en-US-GuyNeural",
        "title": "CROWNLESS: THE GOD RANKING",
        "captions": [
            "A kingdom fell into darkness.",
            "But one warrior refused to kneel.",
            "The gods had already chosen his fate.",
