        ],
        "narration": (
            "A kingdom fell into darkness. "
            "But one warrior refused to kneel. "
            "The gods had already chosen his fate. "
            "Now, he will challenge their power. "
            "But someone rules from the shadows. "
            "No crown. No mercy. Only destiny. "
            "Crownless. The God Ranking."
        )
    },
    "hi": {
        "voice": "hi-IN-SwaraNeural",
        "title": "CROWNLESS: THE GOD RANKING",
        "captions": [
            "Ek samrajya andhere mein doob gaya.",
            "Lekin ek yoddha jhuka nahi.",
